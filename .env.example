# ============ GitLab 配置 ============
GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=your_gitlab_token_here  # 替换为你的GitLab访问令牌，勿提交真实值
AUTHOR_EMAIL=developer@example.com

# 参与的项目 ID，逗号分隔
PROJECT_IDS=101,102

# 项目中文名映射文件（JSON），默认项目根目录 project_names.json
# PROJECT_NAMES_FILE=project_names.json

# ============ LLM 配置（OpenAI 兼容接口） ============
# 支持 OpenAI / 通义 / DeepSeek / 本地 Ollama 等 OpenAI 兼容服务
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=120

# ============ 其他 ============
# 时区偏移（小时），默认东八区
TIMEZONE_OFFSET_HOURS=8

# ============ 定时任务 ============
# Web 服务内置 Python 调度器，启动后自动加载以下配置
# 每天执行时间（24 小时制 HH:mm）
SCHEDULE_TIME=17:30
# 触发星期，逗号分隔：Mon,Tue,Wed,Thu,Fri,Sat,Sun（默认工作日）
SCHEDULE_DAYS=Mon,Tue,Wed,Thu,Fri

# ============ 钉钉群机器人（可选） ============
# 建一个只有自己的群 → 群设置 → 智能群助手 → 添加机器人 → 自定义
# 安全设置建议勾选「加签」，并把加签密钥填到 DINGTALK_SECRET
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token  # 替换为你的钉钉群机器人Webhook，勿提交真实值
# DINGTALK_SECRET=SECxxxxxxxx
DINGTALK_TIMEOUT=15
